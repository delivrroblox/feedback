{
  "name": "usercue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"blue,green\" \"bun run dev:server\" \"bun run dev:vite\"",
    "dev:server": "NODE_ENV=development bun --watch server.ts",
    "dev:vite": "vite",
    "build": "tsc -b && tsc --project tsconfig.server.json && vite build",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc -b && tsc --project tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chalk": "^6.0.1",
    "consola": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
